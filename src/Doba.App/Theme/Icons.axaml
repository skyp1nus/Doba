<!--
  Icon geometry from the prototype's inline SVGs (viewBox 0 0 24 24 unless noted), <rect>/<circle> converted to paths.
  Draw them with the Icon control (Controls/Icon.cs), which scales the viewBox to Size and keeps SVG stroke-width
  semantics: <c:Icon Data="{StaticResource Icon.Search}" Size="14" StrokeWidth="1.8" />.
  The stroke width used by the design is noted next to each icon.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Title bar -->
  <StreamGeometry x:Key="Icon.Logo">M5 12.5l4.5 4.5L19 7.5</StreamGeometry>                     <!-- 11px, 3.2, on #EDEDEF tile 18px r5 -->
  <StreamGeometry x:Key="Icon.Search">M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M20 20l-3.5-3.5</StreamGeometry> <!-- 14px, 1.8 -->
  <!-- Caption buttons: viewBox 0 0 10 10, 10px, stroke 1 -->
  <StreamGeometry x:Key="Icon.Caption.Minimize">M0 5h10</StreamGeometry>
  <StreamGeometry x:Key="Icon.Caption.Maximize">M2 0.5h6a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1 -1.5 1.5h-6a1.5 1.5 0 0 1 -1.5 -1.5v-6a1.5 1.5 0 0 1 1.5 -1.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Caption.Close">M0.5 0.5l9 9M9.5 0.5l-9 9</StreamGeometry>

  <!-- Sidebar (16px, 1.6) -->
  <StreamGeometry x:Key="Icon.Inbox">M3.5 13.5h5l1.5 2.5h4l1.5-2.5h5M5.5 5.5h13l2 8V19a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 19v-5.5z</StreamGeometry>
  <StreamGeometry x:Key="Icon.Today">M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5a2.5 2.5 0 0 1 -2.5 2.5h-12a2.5 2.5 0 0 1 -2.5 -2.5v-10.5a2.5 2.5 0 0 1 2.5 -2.5zM3.5 9.5h17M8 3v4M16 3v4M9 15l2 2 4-4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Calendar">M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5a2.5 2.5 0 0 1 -2.5 2.5h-12a2.5 2.5 0 0 1 -2.5 -2.5v-10.5a2.5 2.5 0 0 1 2.5 -2.5zM3.5 9.5h17M8 3v4M16 3v4M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 17h2M11 17h2</StreamGeometry>
  <StreamGeometry x:Key="Icon.SidebarCollapse">M6 4h12a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-10a3 3 0 0 1 3 -3zM9 4v16M15.5 10l-2 2 2 2</StreamGeometry>
  <StreamGeometry x:Key="Icon.Settings">M4 7h10M18 7h2M4 17h4M12 17h8M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0</StreamGeometry>
  <StreamGeometry x:Key="Icon.Back">M19 12H5M11 6l-6 6 6 6</StreamGeometry>                      <!-- 16px, 1.7 -->

  <!-- Page header -->
  <StreamGeometry x:Key="Icon.Sidebar">M6 4h12a3 3 0 0 1 3 3v10a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-10a3 3 0 0 1 3 -3zM9 4v16</StreamGeometry> <!-- 16px, 1.7 -->
  <StreamGeometry x:Key="Icon.ChevronLeft">M15 6l-6 6 6 6</StreamGeometry>                       <!-- 15px 1.8 (header), 14px 2 (popover) -->
  <StreamGeometry x:Key="Icon.ChevronRight">M9 6l6 6-6 6</StreamGeometry>

  <!-- Lists, dialog, popovers -->
  <StreamGeometry x:Key="Icon.Plus">M12 5v14M5 12h14</StreamGeometry>                            <!-- 14px 1.8 (Add task), 13px 2 (new tag) -->
  <StreamGeometry x:Key="Icon.PlusSmall">M6 12h12M12 6v12</StreamGeometry>                       <!-- 12px, 2 (Lasts +) -->
  <StreamGeometry x:Key="Icon.Minus">M6 12h12</StreamGeometry>                                   <!-- 12px, 2 (Lasts −) -->
  <StreamGeometry x:Key="Icon.Close">M6 6l12 12M18 6L6 18</StreamGeometry>                       <!-- 14px, 1.8 (dialog close) -->
  <StreamGeometry x:Key="Icon.Check">M5 12.5l4.5 4.5L19 7.5</StreamGeometry>                     <!-- checkbox 10/9/8px; menu tick 13px 2.4 -->
  <StreamGeometry x:Key="Icon.ArrowRight">M5 12h14M13 6l6 6-6 6</StreamGeometry>                 <!-- 11px, 2 ("Next week →") -->
  <StreamGeometry x:Key="Icon.Date">M6 5h12a2.5 2.5 0 0 1 2.5 2.5v10.5a2.5 2.5 0 0 1 -2.5 2.5h-12a2.5 2.5 0 0 1 -2.5 -2.5v-10.5a2.5 2.5 0 0 1 2.5 -2.5zM3.5 9.5h17M8 3v4M16 3v4</StreamGeometry> <!-- 14px, 1.7 (Date pill) -->
  <StreamGeometry x:Key="Icon.Clock">M3.5 12a8.5 8.5 0 1 0 17 0a8.5 8.5 0 1 0 -17 0M12 7.5V12l3 2</StreamGeometry> <!-- 14px, 1.7 (Time pill) -->

  <!-- Settings tabs (16px, 1.6) -->
  <StreamGeometry x:Key="Icon.Tab.Appearance">M12 3.5a8.5 8.5 0 1 0 0 17c1.1 0 1.6-0.8 1.6-1.6 0-1-0.8-1.4-0.8-2.3 0-0.9 0.7-1.6 1.6-1.6h1.8a4.8 4.8 0 0 0 4.8-4.8c0-3.9-4-6.7-9-6.7zM7.5 11.5h0.01M10 8h0.01M14.5 8h0.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab.Calendar">M4 5.5h16v14.5H4zM4 10h16M8.5 3.5v4M15.5 3.5v4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab.Tasks">M5 5h14v14H5zM8.5 12l2.5 2.5 4.5-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab.Windows">M3.5 5h17v14h-17zM3.5 9h17</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab.Data">M5 6.5c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3zM5 6.5v11c0 1.7 3.1 3 7 3s7-1.3 7-3v-11M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Tab.Shortcuts">M3.5 7h17v10h-17zM7 10.5h0.01M10 10.5h0.01M13 10.5h0.01M16 10.5h0.01M8 14h8</StreamGeometry>
</ResourceDictionary>
