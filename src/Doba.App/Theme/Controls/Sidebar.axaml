<!--
  Sidebar control themes (Sidebar package). design-reference.dc.html lines 80-143 (.nv rows, .rl, .rail) and 1611-1628.

  SidebarItem (default): a .nv row — 32 px, r6, padding 0 10, 13 px Medium Text.Nav; icon 16 (stroke 1.6) · label ·
  mono 11 Text.Muted count, gap 10. Hover and :current → Text.Strong (200 ms ease); :selected adds the Overlay.Active
  background (settings tabs). The open section's background is the separate sliding SidebarHighlight, not the row.
  SidebarItem.Tag: a tag row — 30 px, 13 px Normal; a 16 px badge instead of the icon: "#" (mono 13 Text.Muted) when
  expanded; in the rail the upper-case initial (10 px SemiBold Text.Secondary on Border.Default, Accent/OnPrimary when
  the tag is the filter). :selected = the active filter (Overlay.Active + Text.Strong).
  :rail (56 px rail): label and count fade to 0 over Motion.RailLabels (180 ms); the Collapse icon (class "collapse")
  turns 180° over Motion.Slide (340 ms ease-out).
  The 32 px rows' label uses the CSS root line height (LineHeight.Body) and the 30 px tag rows the font's natural one:
  that puts both on the prototype's exact pixel rows (measured against docs/design/screens/week.png).
  State styles set the control's own Background/Foreground; the template parts bind them and carry the transitions
  (inside the template, so durations honour Motion.SystemAnimationsEnabled per control).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Doba.App.Controls"
                    xmlns:m="using:Doba.App.Motion"
                    xmlns:sh="using:Doba.App.Shell">

  <ControlTheme x:Key="{x:Type sh:SidebarItem}" TargetType="sh:SidebarItem">
    <Setter Property="Height" Value="{DynamicResource Size.NavItem}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Nav}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Item}" />
    <Setter Property="Padding" Value="{DynamicResource Space.NavItem}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.13}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Item"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Sidebar.ItemGap}">
            <c:Icon Name="PART_Icon"
                    Data="{TemplateBinding Icon}"
                    Size="{DynamicResource Size.Icon}"
                    StrokeWidth="{TemplateBinding IconStrokeWidth}"
                    Foreground="{TemplateBinding Foreground}"
                    VerticalAlignment="Center">
              <c:Icon.Transitions>
                <Transitions>
                  <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
                  <TransformOperationsTransition Property="RenderTransform" Duration="{x:Static m:MotionTimes.Slide}" Easing="{x:Static m:Motion.EaseOut}" />
                </Transitions>
              </c:Icon.Transitions>
            </c:Icon>
            <TextBlock Name="PART_Label"
                       Grid.Column="1"
                       Text="{TemplateBinding Label}"
                       LineHeight="{DynamicResource LineHeight.Body}"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalAlignment="Center">
              <TextBlock.Transitions>
                <Transitions>
                  <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
                  <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.RailLabels}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
            <TextBlock Name="PART_Count"
                       Grid.Column="2"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource FontSize.11}"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       Text="{TemplateBinding Count}"
                       IsVisible="{TemplateBinding Count, Converter={x:Static ObjectConverters.IsNotNull}}"
                       VerticalAlignment="Center">
              <TextBlock.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.RailLabels}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    </Style>
    <Style Selector="^:current">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Active}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Strong}" />
    </Style>
    <Style Selector="^:rail /template/ TextBlock#PART_Label">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:rail /template/ TextBlock#PART_Count">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^.collapse:rail /template/ c|Icon#PART_Icon">
      <Setter Property="RenderTransform" Value="rotate(180deg)" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="SidebarItem.Tag" TargetType="sh:SidebarItem" BasedOn="{StaticResource {x:Type sh:SidebarItem}}">
    <Setter Property="Height" Value="{DynamicResource Size.TagItem}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Item"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
            </Transitions>
          </Border.Transitions>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Sidebar.ItemGap}">
            <Border Name="PART_Badge"
                    Width="{DynamicResource Size.Icon}"
                    Height="{DynamicResource Size.Icon}"
                    CornerRadius="{DynamicResource Radius.Check}"
                    Background="Transparent"
                    VerticalAlignment="Center">
              <Border.Transitions>
                <Transitions>
                  <BrushTransition Property="Background" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </Border.Transitions>
              <TextBlock Name="PART_BadgeText"
                         Text="{TemplateBinding BadgeText}"
                         FontFamily="{DynamicResource Font.Mono}"
                         FontSize="{DynamicResource FontSize.13}"
                         Foreground="{DynamicResource Brush.Text.Muted}"
                         TextAlignment="Center"
                         VerticalAlignment="Center">
                <TextBlock.Transitions>
                  <Transitions>
                    <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
                  </Transitions>
                </TextBlock.Transitions>
              </TextBlock>
            </Border>
            <TextBlock Name="PART_Label"
                       Grid.Column="1"
                       Text="{TemplateBinding Label}"
                       Foreground="{TemplateBinding Foreground}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center">
              <TextBlock.Transitions>
                <Transitions>
                  <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Color}" Easing="{x:Static m:Motion.EaseStd}" />
                  <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.RailLabels}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
            <TextBlock Name="PART_Count"
                       Grid.Column="2"
                       FontFamily="{DynamicResource Font.Mono}"
                       FontSize="{DynamicResource FontSize.11}"
                       Foreground="{DynamicResource Brush.Text.Muted}"
                       Text="{TemplateBinding Count}"
                       IsVisible="{TemplateBinding Count, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextAlignment="Right"
                       Margin="{DynamicResource Sidebar.TagCount}"
                       VerticalAlignment="Center">
              <TextBlock.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.RailLabels}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </TextBlock.Transitions>
            </TextBlock>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:rail /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}" />
    </Style>
    <Style Selector="^:rail /template/ TextBlock#PART_BadgeText">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.10}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="Margin" Value="{DynamicResource Sidebar.RailInitial}" />
    </Style>
    <Style Selector="^:rail:selected /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="^:rail:selected /template/ TextBlock#PART_BadgeText">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
