<!-- Kbd, ProgressLine, TextBox, ScrollViewer/ScrollBar, Slider. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Doba.App.Controls">

  <!-- Kbd (see Kbd.cs for the four looks). -->
  <ControlTheme x:Key="{x:Type c:Kbd}" TargetType="c:Kbd">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.10.5}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Overlay.KbdBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Check}" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Foreground="{TemplateBinding Foreground}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.muted">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="^.onPrimary">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnPrimary}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Overlay.OnPrimary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="^.keycap">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.11}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Bright}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.KeyCap}" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Height" Value="20" />
    </Style>
  </ControlTheme>

  <!-- 2 px progress line: Bg.Track rail (r2, clips the fill), accent fill scaled by Value (see ProgressLine.cs). -->
  <ControlTheme x:Key="{x:Type c:ProgressLine}" TargetType="c:ProgressLine">
    <Setter Property="Height" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.Bg.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Border Name="PART_Fill" Background="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- TextBox: borderless, transparent; placeholder Text.Muted; selection Accent25.
       Classes: "title" (task name: 20 Medium, -0.2 spacing, 40 px), "notes" (13.5 Text.Secondary, line height 1.55,
       multi-line wrap). Field chrome (new-tag box, search) is drawn by the parent. -->
  <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent25}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.13}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="IBeam" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ContentPresenter Grid.Column="0" Content="{TemplateBinding InnerLeftContent}" />
            <ScrollViewer Name="PART_ScrollViewer"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <Panel VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <TextBlock Name="PART_Placeholder"
                           Text="{TemplateBinding PlaceholderText}"
                           Foreground="{TemplateBinding PlaceholderForeground}"
                           TextAlignment="{TemplateBinding TextAlignment}"
                           TextWrapping="{TemplateBinding TextWrapping}"
                           LineHeight="{TemplateBinding LineHeight}"
                           LetterSpacing="{TemplateBinding LetterSpacing}"
                           IsHitTestVisible="False"
                           IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                <TextPresenter Name="PART_TextPresenter"
                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                               CaretBrush="{TemplateBinding CaretBrush}"
                               CaretIndex="{TemplateBinding CaretIndex}"
                               LineHeight="{TemplateBinding LineHeight}"
                               LetterSpacing="{TemplateBinding LetterSpacing}"
                               PasswordChar="{TemplateBinding PasswordChar}"
                               RevealPassword="{TemplateBinding RevealPassword}"
                               SelectionBrush="{TemplateBinding SelectionBrush}"
                               SelectionStart="{TemplateBinding SelectionStart}"
                               SelectionEnd="{TemplateBinding SelectionEnd}"
                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                               Text="{TemplateBinding Text, Mode=TwoWay}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}" />
              </Panel>
            </ScrollViewer>
            <ContentPresenter Grid.Column="2" Content="{TemplateBinding InnerRightContent}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}" />
    </Style>
    <Style Selector="^.title">
      <Setter Property="Height" Value="40" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.20}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacing.DialogTitle}" />
    </Style>
    <Style Selector="^.notes">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.13.5}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
      <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Notes}" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
  </ControlTheme>

  <!-- Scrollbars (.scr): 8 px, transparent track, Border.Strong thumb r4, no arrows; laid out beside the content like
       Chromium's classic scrollbar (the views keep their 12 px right padding). -->
  <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Thumb}" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Check}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Arrow" />
    <Style Selector="^:vertical">
      <Setter Property="Width" Value="{DynamicResource Size.Scrollbar}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Name="PART_Track"
                   Orientation="Vertical"
                   IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{TemplateBinding Value, Mode=TwoWay}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Name="thumb" MinHeight="{DynamicResource Size.Control}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="^:horizontal">
      <Setter Property="Height" Value="{DynamicResource Size.Scrollbar}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Track Name="PART_Track"
                   Orientation="Horizontal"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}"
                   Value="{TemplateBinding Value, Mode=TwoWay}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
              </Track.IncreaseButton>
              <Thumb Name="thumb" MinWidth="{DynamicResource Size.Control}" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  Background="{TemplateBinding Background}"
                                  HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                  VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                  HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                  VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}" />
          <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" />
          <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Slider (Window transparency): Chromium's range drawn with the accent — 8 px rail (Slider.Rail, 1 px Slider.Border,
       r4) inset 1 px from each end of the box (178 px in a 180 px input), accent fill up to the 16 px accent thumb, which
       travels the whole box. Width 180 in Settings; margin 2 is Chromium's UA style for range inputs. -->
  <ControlTheme x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Height="6" Margin="1,0,0,0" VerticalAlignment="Center" CornerRadius="3,0,0,3"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Slider.Rail}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Slider.Border}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Border Name="TrackBackground"
                  Height="8"
                  Margin="1,0"
                  VerticalAlignment="Center"
                  CornerRadius="4"
                  BorderThickness="1"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" />
          <Track Name="PART_Track"
                 Orientation="Horizontal"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SliderFill}" Background="{TemplateBinding Foreground}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource ScrollBarPageButton}" />
            </Track.IncreaseButton>
            <Thumb Name="thumb" Width="16" Height="16" CornerRadius="8" Background="{TemplateBinding Foreground}" />
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
