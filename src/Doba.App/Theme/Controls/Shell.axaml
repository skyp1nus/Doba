<!-- Shell control themes (title bar, page header, main panel, overlay host). Owned by the Shell package. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Window backdrop (design markup lines 45-49): three blurred discs behind the chrome tint. CSS blur() is approximated
    by a radial gradient fill (Brush.Shell.GlowA/B/C: the glow colour with the blur's alpha falloff) on a box grown by ~2σ
    on each side, so nothing is blurred and no offscreen layer is pushed at render time: a redraw of the sidebar or
    title bar (hover) repaints three plain gradient rectangles. Geometry (1600×1000 reference): A 560 px disc at
    (−180, 140) blur 120 → centre (100, 420), drawn 1040×1040; B 420 px at (60, 680) blur 110 → centre (270, 890), drawn
    860×860; C 640×420 at right −220, top −260 blur 120 → centre 100 px left of the right edge, y −50, drawn 1120×900.
    The gradient ellipse is the box's inscribed ellipse and pads with its last (transparent) stop outside it.
  -->
  <ControlTheme x:Key="Shell.Backdrop" TargetType="TemplatedControl">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <!-- A Canvas so the oversized boxes keep their size at any window size (no layout clamping). -->
        <Canvas>
          <Border Canvas.Left="-420" Canvas.Top="-100" Width="1040" Height="1040"
                  Background="{DynamicResource Brush.Shell.GlowA}" />
          <Border Canvas.Left="-160" Canvas.Top="460" Width="860" Height="860"
                  Background="{DynamicResource Brush.Shell.GlowB}" />
          <Border Canvas.Right="-460" Canvas.Top="-500" Width="1120" Height="900"
                  Background="{DynamicResource Brush.Shell.GlowC}" />
        </Canvas>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
