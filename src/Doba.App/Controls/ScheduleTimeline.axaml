<!--
  The Schedule column of Today and Day (the prototype's <aside aria-label="Schedule"> content): header "SCHEDULE · 07–23",
  then a 770 px grid with hour lines every 48 px, task blocks (Button.Bar, r7; compact = one line when < 44 px) and the
  accent now-line (label on Bg.Main, 7 px dot, 1 px line). DataContext = ScheduleViewModel. The screen draws the aside
  frame (380 px, padding-left 24, Border.Subtle left border).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Doba.App.Controls"
             xmlns:m="using:Doba.App.Motion"
             x:Class="Doba.App.Controls.ScheduleTimeline"
             x:DataType="c:ScheduleViewModel">
  <UserControl.Styles>
    <!-- Padding comes from ScheduleBlockViewModel.ContentPadding (design 7 10 0 / compact 0 10 centred, less the 1 px
         ring that Button.Bar draws as a border where the design uses an inset box-shadow); the range's offset under
         or beside the title from ScheduleBlockViewModel.RangeOffset. -->
    <Style Selector="Button.block">
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.block.done">
      <Setter Property="Background" Value="{DynamicResource Brush.Bg.BlockDone}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
    </Style>
    <Style Selector="Button.block.dimmed">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Dimmed}" />
    </Style>
    <!-- StrikeText is styled as TextBlock. -->
    <Style Selector="Button.block.done TextBlock#PART_BlockTitle">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="{StaticResource Space.Schedule.Column}">
    <Grid Name="PART_Header" ColumnDefinitions="*,Auto" Margin="{StaticResource Space.Schedule.Header}">
      <TextBlock Classes="section" Text="SCHEDULE" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="label" Text="{x:Static c:ScheduleViewModel.RangeLabel}" VerticalAlignment="Center" />
    </Grid>

    <Panel Name="PART_Grid" Height="{x:Static c:ScheduleViewModel.GridHeight}" VerticalAlignment="Top">
      <!-- Hour rows are 16 px tall and centred on their line, so the first/last overhang the grid by 8 px: the layer is
           extended by that much (and rows are placed at their line's top) so nothing clips them. -->
      <ItemsControl Name="PART_Hours" ItemsSource="{x:Static c:ScheduleViewModel.Hours}" IsHitTestVisible="False" Margin="{StaticResource Space.Schedule.HourLayer}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Panel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="c:ScheduleHour">
            <!-- The 1 px line is centred on the hour's top (top − 0.5 … top + 0.5), which Chromium paints on the
                 pixel row above the top: row offset 7, not the 7.5 → 8 that centring would round to. -->
            <Grid Margin="{Binding Margin}" Height="{StaticResource Size.Schedule.Row}" VerticalAlignment="Top" ColumnSpacing="{StaticResource Space.Schedule.HourGap}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Size.Schedule.HourLabel}" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Classes="meta" Text="{Binding Label}" VerticalAlignment="Center" />
              <Border Grid.Column="1" Classes="divider" VerticalAlignment="Top" Margin="{StaticResource Space.Schedule.Line}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <ItemsControl Name="PART_Blocks" ItemsSource="{Binding Blocks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Panel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="c:ScheduleBlockViewModel">
            <Button Theme="{StaticResource Button.Bar}"
                    Classes="block"
                    Classes.compact="{Binding IsCompact}"
                    Classes.done="{Binding Row.Done}"
                    Classes.dimmed="{Binding Row.Dimmed}"
                    Margin="{Binding Margin}"
                    Padding="{Binding ContentPadding}"
                    Height="{Binding Height}"
                    Command="{Binding Row.ToggleCommand}"
                    AutomationProperties.Name="{Binding Row.ToggleLabel}">
              <Button.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.Dim}" Easing="{x:Static m:Motion.EaseStd}" />
                </Transitions>
              </Button.Transitions>
              <!-- Title (crisp always-present strike, Text.Muted when done) then range: see ScheduleBlockContent. -->
              <c:ScheduleBlockContent Name="PART_Content"
                                      HorizontalAlignment="Left"
                                      IsCompact="{Binding IsCompact}"
                                      Gap="{x:Static c:ScheduleBlockViewModel.CompactGap}"
                                      RangeOffset="{Binding RangeOffset}">
                <c:StrikeText Name="PART_BlockTitle"
                              Text="{Binding Row.Title}"
                              Struck="{Binding Row.Done}"
                              StrikeColor="{DynamicResource Color.Text.Muted}"
                              FontSize="{DynamicResource FontSize.12.5}"
                              FontWeight="Medium"
                              TextTrimming="CharacterEllipsis"
                              LineHeight="{Binding $self.FontSize, Converter={x:Static c:TaskListRow.CssLineHeight}}">
                  <c:StrikeText.Transitions>
                    <Transitions>
                      <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Strike}" Easing="{x:Static m:Motion.EaseStd}" />
                    </Transitions>
                  </c:StrikeText.Transitions>
                </c:StrikeText>
                <TextBlock Name="PART_Range"
                           Classes="meta-sm tertiary"
                           Text="{Binding Range}"
                           LineHeight="{Binding $self.FontSize, Converter={x:Static c:TaskListRow.CssLineHeight}}" />
              </c:ScheduleBlockContent>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Name="PART_Now"
            IsVisible="{Binding HasNow}"
            Margin="{Binding NowMargin}"
            Height="{StaticResource Size.Schedule.Row}"
            VerticalAlignment="Top"
            ZIndex="2"
            IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{StaticResource Size.Schedule.NowLabel}" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Brush.Bg.Main}">
          <TextBlock Classes="meta accent" Text="{Binding NowLabel}" LineHeight="{StaticResource Size.Schedule.Row}" VerticalAlignment="Center" />
        </Border>
        <Ellipse Grid.Column="1" Width="{StaticResource Size.Schedule.NowDot}" Height="{StaticResource Size.Schedule.NowDot}" Margin="{StaticResource Space.Schedule.NowDot}" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
        <Border Grid.Column="2" Height="1" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="{StaticResource Space.Schedule.Line}" />
      </Grid>
    </Panel>
  </StackPanel>
</UserControl>
