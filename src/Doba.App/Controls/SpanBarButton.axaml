<!--
  Multi-day bar (.hv2): Button.Bar with a 14 px checkbox, the title (12.5/500, one line, ellipsis) and the meta
  ("3 days", "← 4 days", mono 10.5 Text.Tertiary). DataContext: TaskRowViewModel. See SpanBarButton.axaml.cs.
  The state styles (done, tag-filter dim) are declared once per week row in Screens/Week/WeekRowView.axaml.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Doba.App.Controls"
             xmlns:vm="using:Doba.App.ViewModels"
             xmlns:m="using:Doba.App.Motion"
             x:Class="Doba.App.Controls.SpanBarButton"
             x:DataType="vm:TaskRowViewModel"
             FontSize="{DynamicResource FontSize.12.5}"
             CornerRadius="{DynamicResource Radius.Card}">
  <Button Name="PART_Bar"
          Classes="bar"
          Classes.done="{Binding Done}"
          Classes.dimmed="{Binding Dimmed}"
          Theme="{StaticResource Button.Bar}"
          Padding="{DynamicResource Space.Week.Bar}"
          VerticalAlignment="Stretch"
          Command="{Binding ToggleCommand}"
          AutomationProperties.Name="{Binding ToggleLabel}">
    <Button.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.Dim}" Easing="{x:Static m:Motion.EaseStd}" />
      </Transitions>
    </Button.Transitions>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <c:TaskCheckBox Name="PART_Check"
                      BoxSize="14"
                      IsChecked="{Binding Done, Mode=OneWay}"
                      IsHitTestVisible="False"
                      Focusable="False" />
      <c:StrikeText Grid.Column="1"
                    Name="PART_Title"
                    Classes.done="{Binding Done}"
                    Text="{Binding Title}"
                    Struck="{Binding Done}"
                    StrikeColor="{DynamicResource Color.Text.Muted}"
                    FontWeight="Medium"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center">
        <c:StrikeText.Transitions>
          <Transitions>
            <BrushTransition Property="Foreground" Duration="{x:Static m:MotionTimes.Strike}" Easing="{x:Static m:Motion.EaseStd}" />
          </Transitions>
        </c:StrikeText.Transitions>
      </c:StrikeText>
      <TextBlock Grid.Column="2"
                 Classes="meta-sm tertiary"
                 Text="{Binding Meta}"
                 VerticalAlignment="Center" />
    </Grid>
  </Button>
</UserControl>
