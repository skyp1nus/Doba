<!--
  Week task card (.card): checkbox · title (2-line clamp, 13/500, line height 18) · meta (priority button, tag, time).
  DataContext: TaskRowViewModel. See TaskCard.axaml.cs.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Doba.App.Controls"
             xmlns:vm="using:Doba.App.ViewModels"
             xmlns:m="using:Doba.App.Motion"
             x:Class="Doba.App.Controls.TaskCard"
             x:DataType="vm:TaskRowViewModel">
  <UserControl.Styles>
    <!-- Done title: Text.Muted (the Button.Title template fades the colour over Motion.Strike). -->
    <Style Selector="Button.title.done">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
    <!-- Tag filter (0.3), next-week preview (0.55; 0.2 when also filtered out). -->
    <Style Selector="c|Card.dimmed">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Dimmed}" />
    </Style>
    <Style Selector="c|Card.faded">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="c|Card.faded.dimmed">
      <Setter Property="Opacity" Value="0.2" />
    </Style>
  </UserControl.Styles>

  <c:Card Name="PART_Card"
          MinHeight="{DynamicResource Density.CardMinHeight}"
          Classes.dimmed="{Binding Dimmed}">
    <c:Card.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.Dim}" Easing="{x:Static m:Motion.EaseStd}" />
      </Transitions>
    </c:Card.Transitions>
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Density.CardGap}">
      <c:TaskCheckBox VerticalAlignment="Top"
                      Margin="0,1,0,0"
                      IsChecked="{Binding Done, Mode=OneWay}"
                      Command="{Binding ToggleCommand}"
                      AutomationProperties.Name="{Binding ToggleLabel}" />
      <Button Grid.Column="1"
              Name="PART_TitleButton"
              Classes="title"
              Classes.done="{Binding Done}"
              Theme="{StaticResource Button.Title}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              FontSize="{DynamicResource FontSize.13}"
              FontWeight="Medium"
              Command="{Binding OpenCommand}"
              ToolTip.Tip="{Binding Title}">
        <c:StrikeText Name="PART_Title"
                      Text="{Binding Title}"
                      Struck="{Binding Done}"
                      StrikeColor="{DynamicResource Color.Text.Muted}"
                      TextWrapping="Wrap"
                      MaxLines="2"
                      TextTrimming="CharacterEllipsis"
                      LineHeight="{DynamicResource LineHeight.Card}" />
      </Button>
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  Height="{DynamicResource LineHeight.Card}"
                  VerticalAlignment="Top">
        <Button Width="18"
                Height="18"
                CornerRadius="{DynamicResource Radius.Check}"
                IsVisible="{Binding HasPriority}"
                Command="{Binding CyclePriorityCommand}"
                ToolTip.Tip="{Binding PriorityTitle}"
                AutomationProperties.Name="{Binding PriorityLabel}">
          <c:PriorityIcon Priority="{Binding Priority}" />
        </Button>
        <TextBlock Classes="meta-sm" Text="{Binding TagLabel}" IsVisible="{Binding HasTag}" VerticalAlignment="Center" />
        <TextBlock Classes="meta-sm secondary" Text="{Binding Time}" IsVisible="{Binding HasTime}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </c:Card>
</UserControl>
