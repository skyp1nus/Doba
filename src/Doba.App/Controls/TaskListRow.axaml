<!--
  A task in a list (Inbox, Today; Day reuses it): the prototype's <li data-id> row. DataContext = TaskRowViewModel.
  Layout (flex, gap 12, padding Density.RowPadding = 11 4, 1 px Border.Subtle bottom border):
  checkbox 16 · priority button 18 (margin-left −4) · title (fills, ellipsis) · [#tag] meta · [→ Today].
  The title's strike-through (StrikeText) is always present; only its colour animates (Motion.Strike).
  Keyboard: Space anywhere in the row completes the task (code-behind); Enter activates the focused button.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Doba.App.Controls"
             xmlns:m="using:Doba.App.Motion"
             xmlns:vm="using:Doba.App.ViewModels"
             x:Class="Doba.App.Controls.TaskListRow"
             x:DataType="vm:TaskRowViewModel"
             MetaForeground="{DynamicResource Brush.Text.Secondary}"
             Classes.done="{Binding Done}"
             Classes.dimmed="{Binding Dimmed}">
  <UserControl.Transitions>
    <Transitions>
      <DoubleTransition Property="Opacity" Duration="{x:Static m:MotionTimes.Dim}" Easing="{x:Static m:Motion.EaseStd}" />
    </Transitions>
  </UserControl.Transitions>
  <UserControl.Styles>
    <Style Selector="c|TaskListRow.dimmed">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Dimmed}" />
    </Style>
    <Style Selector="c|TaskListRow.done Button#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
  </UserControl.Styles>

  <Border Name="PART_Row"
          Background="Transparent"
          BorderBrush="{DynamicResource Brush.Border.Subtle}"
          BorderThickness="0,0,0,1"
          Padding="{DynamicResource Density.RowPadding}">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
      <!-- Centred with a 1 px bottom margin: the title line (18.9 px) measures 19 px here, and centring the 16 px box
           in it would land on +1.5 → +2, while Chromium centres it in 18.9 px and paints it at +1. With the margin it
           lands on +1 in a 19 px row and still on +4 in a 24 px row (with "→ Today"), as in the design. -->
      <c:TaskCheckBox Name="PART_Check"
                      Margin="0,0,0,1"
                      IsChecked="{Binding Done, Mode=OneWay}"
                      Command="{Binding ToggleCommand}"
                      AutomationProperties.Name="{Binding ToggleLabel}" />
      <Button Name="PART_Priority"
              Grid.Column="1"
              Width="18"
              Height="18"
              Margin="8,0,0,0"
              CornerRadius="{DynamicResource Radius.Check}"
              Command="{Binding CyclePriorityCommand}"
              ToolTip.Tip="{Binding PriorityTitle}"
              AutomationProperties.Name="{Binding PriorityLabel}">
        <c:PriorityIcon Priority="{Binding Priority}" />
      </Button>
      <!-- Content is the row view-model (set in code-behind) so a recycled row can rebuild its title: see
           TaskListRow.ShowRow. The strike is StrikeText's crisp 1 px line (Text.Muted), always present. -->
      <Button Name="PART_Title"
              Grid.Column="2"
              Theme="{StaticResource Button.Title}"
              Margin="12,0,0,0"
              HorizontalAlignment="Stretch"
              Command="{Binding OpenCommand}"
              AutomationProperties.Name="{Binding Title}">
        <Button.ContentTemplate>
          <DataTemplate x:DataType="vm:TaskRowViewModel">
            <c:StrikeText Text="{Binding Title}"
                          Struck="{Binding Done}"
                          StrikeColor="{DynamicResource Color.Text.Muted}"
                          TextTrimming="CharacterEllipsis"
                          LineHeight="{Binding $self.FontSize, Converter={x:Static c:TaskListRow.CssLineHeight}}" />
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
        <TextBlock Name="PART_Tag" Classes="meta" Text="{Binding TagLabel}" IsVisible="{Binding HasTag}" VerticalAlignment="Center" />
        <TextBlock Name="PART_Meta" Classes="meta" Text="{Binding Meta}" VerticalAlignment="Center"
                   Foreground="{Binding $parent[c:TaskListRow].MetaForeground}" />
        <Button Name="PART_Move"
                Theme="{StaticResource Button.Small}"
                Content="→ Today"
                VerticalAlignment="Center"
                IsVisible="{Binding CanMoveToToday}"
                Command="{Binding MoveToTodayCommand}"
                AutomationProperties.Name="{Binding MoveLabel}" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
