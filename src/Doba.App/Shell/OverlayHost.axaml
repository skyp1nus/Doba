<!--
  In-window overlay layer (task dialog, search palette): covers the whole window including the title bar with the
  shade (Brush.Bg.Shade over the window content, which OverlayHost blurs while an overlay is open: the prototype's
  backdrop-filter: blur(3px)) and hosts the overlay view at
  Size.Dialog.Top, Size.Dialog.Width wide, centred. Never an Avalonia Popup. DataContext: MainViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sh="using:Doba.App.Shell"
             x:Class="Doba.App.Shell.OverlayHost"
             x:DataType="sh:MainViewModel"
             IsVisible="False">
  <Panel>
    <Border Name="PART_Shade" Background="{DynamicResource Brush.Bg.Shade}" />
    <Panel Name="PART_Panel"
           Width="{DynamicResource Size.Dialog.Width}"
           HorizontalAlignment="Center"
           VerticalAlignment="Top"
           Focusable="True"
           KeyboardNavigation.TabNavigation="Cycle" />
  </Panel>
</UserControl>
