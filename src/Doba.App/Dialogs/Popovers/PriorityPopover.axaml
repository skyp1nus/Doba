<!--
  Priority popover (design-reference lines 774-785): No priority / Low / Medium / High / ASAP, each with the shared
  priority glyph, the chosen one on Overlay.Selected with the accent tick. Picking closes it. DataContext: the dialog.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Doba.App.Controls"
             xmlns:d="using:Doba.App.Dialogs"
             x:Class="Doba.App.Dialogs.Popovers.PriorityPopover"
             x:DataType="d:TaskDialogViewModel"
             ClipToBounds="False">
  <Border Name="PART_Surface"
          Classes="popover-sm"
          Width="{DynamicResource Size.Popover.List}"
          Padding="{DynamicResource Space.Dialog.PopoverList}">
    <ItemsControl Name="PART_Items" ItemsSource="{Binding PriorityOptions}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="d:PriorityOptionItem">
          <Button Theme="{StaticResource Button.Menu}"
                  Classes.selected="{Binding IsSelected}"
                  Command="{Binding PickCommand}"
                  AutomationProperties.Name="{Binding Label}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Space.Dialog.MenuGap}">
              <Panel Width="{DynamicResource Size.Dialog.MenuIcon}">
                <c:PriorityIcon Priority="{Binding Priority}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Panel>
              <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
              <Panel Grid.Column="2" Width="{DynamicResource Size.Dialog.MenuIcon}">
                <c:Icon Data="{StaticResource Icon.Check}"
                        Size="{DynamicResource Size.Dialog.MenuTick}"
                        StrokeWidth="2.4"
                        Foreground="{DynamicResource Brush.Accent}"
                        IsVisible="{Binding IsSelected}" />
              </Panel>
            </Grid>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Border>
</UserControl>
